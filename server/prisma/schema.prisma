// ========================================================
// 22. DIRECT EXPERT ACCESS & CONSULTATIONS
// ========================================================

model ExpertProfile {
  id                 String               @id @default(uuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String               // e.g. "Senior Agronomist", "Plant Pathology Specialist"
  institution        String               // TNAU Coimbatore, ICAR, KVK, State Horticulture Dept
  specialization     String               // ENTOMOLOGY, PLANT_PATHOLOGY, SOIL_SCIENCE, HORTICULTURE, ORGANIC_FARMING, AGRONOMY
  experienceYears    Int                  @default(8)
  languagesSpoken    String               // "Tamil, English, Hindi"
  qualifications     String               // "Ph.D. Plant Pathology (TNAU)"
  bio                String
  consultationFee    Float                @default(0) // ₹0 = Free Extension Advisory
  isVerified         Boolean              @default(true)
  isAvailableNow     Boolean              @default(true)
  rating             Float                @default(4.9)
  consultationsCount Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  availabilities     ExpertAvailability[]
  consultations      ExpertConsultation[]
  reviews            ExpertReview[]

  @@index([specialization])
  @@index([isVerified])
}

model ExpertAvailability {
  id          String        @id @default(uuid())
  expertId    String
  expert      ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  dayOfWeek   String        // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY
  startTime   String        // "09:00"
  endTime     String        // "17:00"
  isAvailable Boolean       @default(true)

  @@index([expertId])
}

model ExpertConsultation {
  id                 String         @id @default(uuid())
  consultationNumber String         @unique
  farmerId           String
  farmer             User           @relation("FarmerConsultations", fields: [farmerId], references: [id], onDelete: Cascade)
  expertId           String
  expertUser         User           @relation("ExpertConsultations", fields: [expertId], references: [id], onDelete: Cascade)
  expertProfileId    String
  expertProfile      ExpertProfile  @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  topic              String         // PEST_DISEASE_DIAGNOSIS, SOIL_FERTILITY, CROP_PLANNING, SCHEME_ADVICE
  cropName           String?
  problemSummary     String
  cropImageUrl       String?
  scheduledDate      DateTime
  scheduledSlot      String         // e.g. "10:00 AM - 10:30 AM"
  status             String         @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  prescriptionAdvice String?        // Written prescription / treatment notes by scientist
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([farmerId])
  @@index([expertId])
  @@index([expertProfileId])
  @@index([status])
}

model ExpertReview {
  id              String        @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  farmerId        String
  farmer          User          @relation("ExpertReviewsGiven", fields: [farmerId], references: [id], onDelete: Cascade)
  rating          Int           // 1 to 5
  feedback        String
  createdAt       DateTime      @default(now())

  @@index([expertProfileId])
  @@index([farmerId])
}
