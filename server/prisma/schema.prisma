  bankName           String            // SBI, Canara Bank, NABARD, Indian Bank, HDFC Agri
  loanName           String            // Kisan Credit Card (KCC), Agri Term Loan, Tractor & Mechanization Loan, Gold Loan for Farming
  code               String            @unique
  interestRatePct    Float             // e.g. 7.0%
