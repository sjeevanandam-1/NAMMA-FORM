// ========================================================
// NAMMA FARM - COMPREHENSIVE PRODUCTION PRISMA SCHEMA
// ========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// USER & ROLE MODELS
// --------------------------------------------------------

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  phone            String             @unique
  name             String
  passwordHash     String
  role             String             // "FARMER" | "BUYER" | "EXPERT" | "GOVERNMENT_OFFICIAL" | "ADMIN"
  isVerified       Boolean            @default(false)
  avatarUrl        String?
  refreshToken     String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  farmerProfile    FarmerProfile?
  buyerProfile     BuyerProfile?
  govProfile       GovernmentProfile?
  expertProfile    ExpertProfile?
  trustScore       TrustScore?
  farmerPassport   FarmerPassport?
  notifPref        NotificationPreference?
  
  // Relations
  listings         CropListing[]      @relation("FarmerListings")
  farmerOrders     Order[]            @relation("FarmerOrders")
  buyerOrders      Order[]            @relation("BuyerOrders")
  notifications    Notification[]
  sentMessages     Message[]          @relation("SentMessages")
  farmerConvs      Conversation[]     @relation("FarmerConversations")
  buyerConvs       Conversation[]     @relation("BuyerConversations")
  reviewsGiven     Review[]           @relation("ReviewsGiven")
  reviewsReceived  Review[]           @relation("ReviewsReceived")
  diseaseScans     DiseaseScan[]
  aiRecs           AIRecommendation[]
  profitPreds      ProfitPrediction[]
  farmerQueries    FarmerQuery[]      @relation("FarmerSubmittedQueries")
  queryMessages    QueryMessage[]     @relation("QueryMessageSender")
  aiConversations  AIConversation[]
  favorites        Favorite[]
  auditLogs        AuditLog[]

  // New Feature Relations
  schemeApps       SchemeApplication[]
  savedSchemes     SavedScheme[]
  procBookings     ProcurementBooking[]
  storageBookings  StorageBooking[]
  supportTickets   SupportTicket[]
  ticketMessages   TicketMessage[]
  cropCalendars    CropCalendar[]
  equipBookings    EquipmentBooking[]
  transportBookings TransportBooking[]
  loanApps         LoanApplication[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims  InsuranceClaim[]
  communityPosts   CommunityPost[]
  communityComments CommunityComment[]
  communityLikes   CommunityLike[]
  communityReports CommunityReport[]
  wasteListings    AgriWasteListing[]
  wasteOffers      WasteOffer[]
  wasteOrders      WasteOrder[]
  farmerConsults   ExpertConsultation[] @relation("FarmerConsultations")
  expertConsults   ExpertConsultation[] @relation("ExpertConsultations")
  expertReviews    ExpertReview[]     @relation("ExpertReviewsGiven")

  @@index([email])
  @@index([phone])
  @@index([role])
}

model FarmerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state            String
  district         String
  village          String
  farmLocation     String
  landAreaAcre     Float
  soilType         String   // Alluvial, Red, Black, Sandy, Clay, Loamy
  irrigationType   String   // Drip, Sprinkler, Canal, Borewell, Rainfed
  mainCrops        String   // JSON stringified or comma-separated list of crops
  kycStatus        String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  idProofUrl       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  farms            Farm[]

  @@index([state, district])
}

model BuyerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  businessType     String   // WHOLESALER, RETAILER, EXPORTER, PROCESSOR, AGGREGATOR
  gstNumber        String?
  state            String
  district         String
  location         String
  requiredCrops    String   // JSON array or comma separated
  kycStatus        String   @default("VERIFIED") // PENDING, VERIFIED, REJECTED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([state, district])
  @@index([businessType])
}

model GovernmentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  officialId       String   @unique
  department       String
  designation      String
  state            String
  district         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([officialId])
  @@index([state])
}

// --------------------------------------------------------
// FARM & CROP MANAGEMENT
// --------------------------------------------------------

model Farm {
  id               String        @id @default(uuid())
  farmerProfileId  String
  farmerProfile    FarmerProfile @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  farmName         String
  location         String
  latitude         Float?
  longitude        Float?
  landAreaAcre     Float
  soilType         String
  irrigation       String
  crops            String        // JSON array or comma separated
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  listings         CropListing[]

  @@index([farmerProfileId])
}

model Crop {
  id                  String   @id @default(uuid())
  name                String   @unique
  category            String   // VEGETABLES, FRUITS, GRAINS, PULSES, SPICES, CASH_CROPS
  variety             String?
  description         String
  season              String   // KHARIF, RABI, ZAID, YEAR_ROUND
  idealSoil           String
  gestationPeriodDays Int
  imageUrl            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  listings            CropListing[]
  marketPrices        MarketPrice[]
  predictions         MarketPrediction[]

  @@index([category])
}

// --------------------------------------------------------
// LISTINGS & MARKETPLACE
// --------------------------------------------------------

model CropListing {
  id                   String      @id @default(uuid())
  farmerId             String
  farmer               User        @relation("FarmerListings", fields: [farmerId], references: [id], onDelete: Cascade)
  farmId               String?
  farm                 Farm?       @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cropId               String
  crop                 Crop        @relation(fields: [cropId], references: [id])
  variety              String
  quantityKg           Float
  availableQuantityKg  Float
  unit                 String      @default("KG") // KG, QUINTAL, TON
  expectedPricePerKg   Float
  minAcceptablePrice   Float
  harvestDate          DateTime
  qualityGrade         String      // GRADE_A, GRADE_B, GRADE_C
  description          String
  location             String
  district             String
  state                String
  status               String      @default("ACTIVE") // DRAFT, ACTIVE, RESERVED, SOLD, EXPIRED, CANCELLED
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  images               CropImage[]
  orders               Order[]
  orderItems           OrderItem[]
  conversations        Conversation[]
  favorites            Favorite[]

  @@index([farmerId])
  @@index([cropId])
  @@index([status])
  @@index([state, district])
  @@index([qualityGrade])
  @@index([expectedPricePerKg])
}

model CropImage {
  id        String      @id @default(uuid())
  listingId String
  listing   CropListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([listingId])
}

// --------------------------------------------------------
// ORDERS & TRANSACTIONS
// --------------------------------------------------------

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  buyerId          String
  buyer            User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmerId         String
  farmer           User        @relation("FarmerOrders", fields: [farmerId], references: [id])
  listingId        String
  listing          CropListing @relation(fields: [listingId], references: [id])
  quantityKg       Float
  pricePerKg       Float
  totalAmount      Float
  transportCost    Float       @default(0)
  taxAmount        Float       @default(0)
  grandTotal       Float
  status           String      @default("PENDING") // PENDING, ACCEPTED, REJECTED, CONFIRMED, PACKED, READY_FOR_PICKUP, PICKED_UP, IN_TRANSIT, DELIVERED, COMPLETED, CANCELLED
  deliveryAddress  String
  deliveryDate     DateTime?
  notes            String?
  rejectionReason  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            OrderItem[]
  payment          Payment?
  delivery         Delivery?
  reviews          Review[]

  @@index([buyerId])
  @@index([farmerId])
  @@index([listingId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId   String
  listing     CropListing @relation(fields: [listingId], references: [id])
  quantityKg  Float
  unitPrice   Float
  subtotal    Float
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId String        @unique
  amount        Float
  currency      String        @default("INR")
  paymentMethod String        // UPI, CARD, NET_BANKING, CASH_ON_DELIVERY, ESCROW
  status        String        @default("PENDING") // PENDING, AUTHORIZED, PAID, FAILED, REFUNDED
  provider      String        @default("MOCK_DEV")
  providerRef   String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions  Transaction[]

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

model Transaction {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type        String   // PAYMENT, REFUND, PAYOUT, COMMISSION
  amount      Float
  fee         Float    @default(0)
  netAmount   Float
  status      String   @default("SUCCESS") // SUCCESS, PENDING, FAILED
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

model Delivery {
  id                    String    @id @default(uuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicleType           String    // MINI_TRUCK, TRUCK_3TON, REFRIGERATED_VAN, TRACTOR
  driverName            String?
  driverPhone           String?
  vehicleNumber         String?
  trackingNumber        String    @unique
  estimatedCost         Float
  pickupLocation        String
  deliveryLocation      String
  pickupTime            DateTime?
  estimatedDeliveryTime DateTime?
  actualDeliveryTime    DateTime?
  status                String    @default("REQUESTED") // REQUESTED, ASSIGNED, PICKED_UP, IN_TRANSIT, DELIVERED
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

// --------------------------------------------------------
// MARKET DATA & AI PREDICTION
// --------------------------------------------------------

model MarketPrice {
  id          String   @id @default(uuid())
  cropId      String?
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropName    String
  marketName  String   // Mandi name (e.g. Azadpur, Koyambedu, Vashi)
  district    String
  state       String
  modalPrice  Float    // Avg price per kg
  minPrice    Float
  maxPrice    Float
  unit        String   @default("KG")
  recordDate  DateTime
  source      String   // AGMARKNET, STATE_APMC, DEMO_SIMULATOR
  sourceUrl   String?
  isDemoData  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cropName])
  @@index([state, district])
  @@index([recordDate])
}

model MarketPriceSource {
  id           String    @id @default(uuid())
  name         String
  url          String
  state        String
  lastSyncedAt DateTime?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
}

model MarketPrediction {
  id                 String   @id @default(uuid())
  cropId             String
  crop               Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  currentPrice       Float
  predictedPrice7d   Float
  predictedPrice14d  Float
  predictedPrice30d  Float
  trend              String   // RISING, FALLING, STABLE
  confidenceScore    Float    // 0 to 100
  advisoryNote       String
  calculatedAt       DateTime @default(now())

  @@index([cropId])
}

// --------------------------------------------------------
// AI CROP DOCTOR & RECOMMENDATIONS
// --------------------------------------------------------

model DiseaseScan {
  id                 String                  @id @default(uuid())
  farmerId           String
  farmer             User                    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropName           String
  imageUrl           String
  diseaseName        String
  confidenceScore    Float                   // Percentage e.g. 91.5
  severity           String                  // LOW, MEDIUM, HIGH
  observedSymptoms   String
  possibleCauses     String
  status             String                  @default("ACTIVE") // ACTIVE, RESOLVED, RECURRING
  followUpStatus     String?                 // IMPROVING, STABLE, POSSIBLY_WORSENING, UNCERTAIN
  parentScanId       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  recommendation     DiseaseRecommendation?

  @@index([farmerId])
  @@index([cropName])
}

model DiseaseRecommendation {
  id                     String      @id @default(uuid())
  scanId                 String      @unique
  scan                   DiseaseScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  diseaseName            String
  organicTreatment       String
  chemicalTreatment      String
  safetyGuideline        String
  expertConsultationNote String
  sourceName             String      // e.g. ICAR / TNAU Agricultural University
  verificationDate       DateTime

  @@index([scanId])
}

model AIRecommendation {
  id          String   @id @default(uuid())
  farmerId    String
  farmer      User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  category    String   // SELLING_STRATEGY, CROP_SELECTION, MARKET_TIMING, WEATHER_RISK
  title       String
  summary     String
  actionItems String   // JSON array string
  confidence  Float    @default(88.0)
  isDismissed Boolean  @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([farmerId])
  @@index([category])
}

model ProfitPrediction {
  id               String   @id @default(uuid())
  farmerId         String
  farmer           User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropName         String
  landAreaAcre     Float
  expectedYieldKg  Float
  productionCost   Float
  transportCost    Float
  sellingPricePerKg Float
  estimatedRevenue Float
  estimatedProfit  Float
  profitMarginPct  Float
  comparisonData   String   // JSON string comparing buyers and markets
  createdAt        DateTime @default(now())

  @@index([farmerId])
}

model WeatherData {
  id              String   @id @default(uuid())
  district        String
  state           String
  temperature     Float
  humidity        Float
  rainfallMm      Float
  rainProbability Float
  windSpeedKmh    Float
  condition       String   // Sunny, Rainy, Cloudy, Stormy
  forecastDays    String   // JSON string of 7-day forecast
  agroAdvisory    String
  isDemoData      Boolean  @default(false)
  updatedAt       DateTime @default(now())

  @@index([state, district])
}

// --------------------------------------------------------
// SOCIAL, CHAT, REVIEWS & TRUST
// --------------------------------------------------------

model Conversation {
  id        String      @id @default(uuid())
  farmerId  String
  farmer    User        @relation("FarmerConversations", fields: [farmerId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User        @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  listingId String?
  listing   CropListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  Message[]

  @@unique([farmerId, buyerId, listingId])
  @@index([farmerId])
  @@index([buyerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Review {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating      Int      // 1 to 5
  comment     String
  role        String   // BUYER_TO_FARMER | FARMER_TO_BUYER
  createdAt   DateTime @default(now())

  @@unique([orderId, reviewerId])
  @@index([revieweeId])
}

model TrustScore {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score                  Float    @default(80.0) // Out of 100
  verifiedIdentityScore  Float    @default(25.0) // Max 25
  completedOrdersScore   Float    @default(30.0) // Max 35
  ratingScore            Float    @default(25.0) // Max 30
  disputePenaltyScore    Float    @default(0.0)  // Deductions
  explanation            String
  calculatedAt           DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // ORDER_CREATED, PRICE_ALERT, WEATHER_ALERT, SCHEME_ALERT, CALENDAR_TASK, STORAGE_UPDATE, TRANSPORT_UPDATE, LOAN_UPDATE, INSURANCE_ALERT, EXPERT_APPOINTMENT, COMMUNITY_ACTIVITY
  isRead    Boolean  @default(false)
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceAlerts      Boolean  @default(true)
  weatherAlerts    Boolean  @default(true)
  schemeAlerts     Boolean  @default(true)
  calendarTasks    Boolean  @default(true)
  buyerOffers      Boolean  @default(true)
  communityUpdates Boolean  @default(true)
  smsEnabled       Boolean  @default(false)
  emailEnabled     Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model Favorite {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   CropListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // REGISTER, LOGIN, LISTING_CREATE, ORDER_CREATE, STATUS_CHANGE, PAYMENT, ADMIN_ACTION, MARKET_IMPORT
  entityType String   // USER, LISTING, ORDER, PAYMENT, MARKET_PRICE, CROP, SCHEME, EQUIPMENT, TRANSPORT, LOAN, INSURANCE
  entityId   String?
  details    String   // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// --------------------------------------------------------
// PHONE OTP VERIFICATION
// --------------------------------------------------------

model OTPVerification {
  id         String   @id @default(uuid())
  phone      String
  otpHash    String
  attempts   Int      @default(0)
  isVerified Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([phone])
}

// --------------------------------------------------------
// FARMER QUERY & EXTENSION SUPPORT SYSTEM
// --------------------------------------------------------

model FarmerQuery {
  id          String            @id @default(uuid())
  farmerId    String
  farmer      User              @relation("FarmerSubmittedQueries", fields: [farmerId], references: [id], onDelete: Cascade)
  category    String            // PEST_DISEASE, SCHEME_SUBSIDY, SOIL_NUTRIENT, CROP_ADVICE, GENERAL
  crop        String?
  title       String
  description String
  location    String
  status      String            @default("OPEN") // OPEN, IN_PROGRESS, ANSWERED, CLOSED
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  messages    QueryMessage[]
  attachments QueryAttachment[]

  @@index([farmerId])
  @@index([status])
}

model QueryMessage {
  id        String      @id @default(uuid())
  queryId   String
  query     FarmerQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation("QueryMessageSender", fields: [senderId], references: [id])
  content   String
  createdAt DateTime    @default(now())

  @@index([queryId])
  @@index([senderId])
}

model QueryAttachment {
  id        String      @id @default(uuid())
  queryId   String
  query     FarmerQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String      // IMAGE, DOCUMENT
  createdAt DateTime    @default(now())

  @@index([queryId])
}

// --------------------------------------------------------
// AI ASSISTANT CONVERSATION & CHAT MEMORY
// --------------------------------------------------------

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("Agricultural Advisory")
  language  String      @default("en") // "en" | "ta"
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // "user" | "assistant"
  content        String
  audioInput     Boolean        @default(false)
  imageUrl       String?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ========================================================
// 1. GOVERNMENT SCHEMES HUB
// ========================================================

model GovernmentScheme {
  id                 String              @id @default(uuid())
  title              String
  titleTamil         String?
  code               String              @unique // e.g. PM-KISAN, PMFBY, SMAM, SHC
  category           String              // FINANCIAL_SUPPORT, CROP_INSURANCE, IRRIGATION, FARM_MACHINERY, SOIL_FERTILIZER, ORGANIC_FARMING, HORTICULTURE
  level              String              @default("CENTRAL") // CENTRAL, STATE
  state              String?             // Null for Central, or state name
  subsidyPct         Float?              // e.g. 50.0%
  maxAmount          Float?              // e.g. 6000 or 50000
  description        String
  descriptionTamil   String?
  benefits           String              // Detailed bullet points
  eligibilityCriteria String             // JSON string or criteria text
  requiredDocuments  String              // JSON string array of docs
  applicationProcess String              // Step-by-step instructions
  officialPortalUrl  String?
  deadline           DateTime?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  applications       SchemeApplication[]
  savedBy            SavedScheme[]

  @@index([category])
  @@index([level, state])
  @@index([isActive])
}

model SchemeApplication {
  id                 String           @id @default(uuid())
  schemeId           String
  scheme             GovernmentScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  farmerId           String
  farmer             User             @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  applicationNumber  String           @unique
  applicantName      String
  applicantPhone     String
  landAreaAcre       Float
  aadhaarLast4       String
  bankAccountNumber  String
  ifscCode           String
  village            String
  district           String
  state              String
  documentsSubmitted String           // JSON array of uploaded document URLs
  status             String           @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, VERIFIED, APPROVED, REJECTED, DISBURSED
  officialRemarks    String?
  disbursedAmount    Float?
  disbursedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

