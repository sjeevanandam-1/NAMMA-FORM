  approvedAmount     Float?
  bankOfficerRemarks String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([farmerId])
  @@index([loanProductId])
  @@index([status])
}

// ========================================================
// 16. CROP INSURANCE ASSISTANCE
// ========================================================

model InsuranceProduct {
  id                 String            @id @default(uuid())
  schemeName         String            // Pradhan Mantri Fasal Bima Yojana (PMFBY), Restructured WBCIS
  providerName       String            // AIC of India, HDFC ERGO Agri, ICICI Lombard, State Insurance Pool
  season             String            // KHARIF, RABI, ANNUAL_COMMERCIAL
  premiumRatePct     Float             // 2.0% Kharif, 1.5% Rabi, 5.0% Commercial
  coveredCrops       String            // JSON string array
  coveredRisks       String            // JSON string array: ["Prevented Sowing", "Mid-Season Adversity", "Post-Harvest Losses", "Localized Calamities (Hailstorm, Landslide, Inundation)"]
  claimSettlementAvg Float             @default(94.5) // Settlement percentage
  cutOffDate         DateTime
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())

  policies           InsurancePolicy[]

  @@index([season])
  @@index([isActive])
}

model InsurancePolicy {
  id                 String           @id @default(uuid())
  policyNumber       String           @unique
  productId          String
  product            InsuranceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  farmerId           String
  farmer             User             @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropName           String
  season             String
  year               String           // "2026"
  landAreaAcre       Float
  sumInsured         Float            // Total insured coverage amount in INR
  farmerPremiumPaid  Float            // Farmer's share (1.5% - 2%)
  govtSubsidyAmount  Float            // Central + State share
  village            String
  district           String
  state              String
  surveyNumber       String
  status             String           @default("ACTIVE") // ACTIVE, EXPIRED, CLAIM_IN_PROGRESS, SETTLED
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  claims             InsuranceClaim[]

  @@index([farmerId])
  @@index([productId])
  @@index([status])
}

model InsuranceClaim {
  id                 String          @id @default(uuid())
  claimNumber        String          @unique
  policyId           String
  policy             InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  farmerId           String
  farmer             User            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  lossCause          String          // HAILSTORM, UNSEASONAL_RAINFALL, FLOOD_INUNDATION, DROUGHT, PEST_EPIDEMIC, CYCLONE
  lossDate           DateTime
  estimatedLossPct   Float           // e.g. 70.0%
  claimedAmount      Float
  damagePhotoUrl     String?
  lossDescription    String
  surveyorName       String?
  surveyDate         DateTime?
  status             String          @default("FILED") // FILED, SURVEY_ASSIGNED, ASSESSMENT_COMPLETED, APPROVED, SETTLED, REJECTED
  approvedAmount     Float?
  settledAt          DateTime?
  remarks            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([farmerId])
  @@index([policyId])
  @@index([status])
}

// ========================================================
// 17. DIGITAL FARMER PASSPORT
