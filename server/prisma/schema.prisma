  moisturePercentage Float?
  paymentRefNumber   String?
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([farmerId])
  @@index([centerId])
  @@index([status])
}

// ========================================================
